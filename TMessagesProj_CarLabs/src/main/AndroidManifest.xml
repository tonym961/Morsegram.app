<?xml version="1.0" encoding="utf-8"?>
<!-- Morsegram - Android Auto "templated messaging" (Car App Library, labs). Modulo opt-in: vedi build.gradle e MORSEGRAM.md.
     Il blocco ricalca quello che upstream tiene commentato in TMessagesProj/src/main/AndroidManifest.xml (minCarApiLevel 5 -> 7). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- il service dichiara foregroundServiceType="connectedDevice" come upstream: dal targetSdk 34 il tipo esige il permesso corrispondente -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- microfono dell'auto (androidx.car.app.media.CarAudioRecord): l'host apre il mic solo se
         l'app dichiara RECORD_AUDIO. L'app principale (TMessagesProj) lo dichiara gia' e il manifest
         unito lo riporta: lo ripetiamo qui perche' il modulo labs non dipenda da quella riga. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <service
            android:name="it.iotatec.morsegram.carlabs.car.MorsegramCarAppService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MESSAGING" />
            </intent-filter>
        </service>

        <!-- ConversationItem (templated messaging) richiede Car API level 7 -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />
    </application>

</manifest>

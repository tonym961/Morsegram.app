<?xml version="1.0" encoding="utf-8"?>
<!-- <morsegram> Android 12+: il raggio degli angoli e' quello che chiede il sistema
     (@android:dimen/system_app_widget_background_radius, max 28dp), non un valore nostro: e' il contratto
     degli angoli arrotondati dei widget su Android 12. Vale per la scelta "Arrotondati" (predefinita);
     "Quadrati" e "Molto arrotondati" restano scelte esplicite dell'utente. </morsegram> -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke android:width="1dp" android:color="#E7DFD0" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>

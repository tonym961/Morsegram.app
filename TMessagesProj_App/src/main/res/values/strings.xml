    <!-- schermata introduttiva, prima dell'accesso (IntroActivity). Ordine a video: 1 logo, 2 Fast, 3 Free,
         4 = Page5 (Powerful), 5 = Page4 (Secure), 6 Cloud. Nessuna rivendicazione falsa: siamo un client terzo. -->
    <string name="MorsegramIntroTitle1">Morsegram</string>
    <string name="MorsegramIntroText1">An **unofficial** client for Telegram.\nFree software, **GPL-2.0-or-later**.</string>
    <string name="MorsegramIntroTitle2">Fast</string>
    <string name="MorsegramIntroText2">Morsegram talks to the Telegram network\ndirectly: messages arrive just as fast.</string>
    <string name="MorsegramIntroTitle3">Free</string>
    <string name="MorsegramIntroText3">No ads of ours, no tracking of ours,\nand the **source code** is published.</string>
    <string name="MorsegramIntroTitle4">Secure</string>
    <string name="MorsegramIntroText4">Nothing sits between you and the Telegram\nservers: **same protocol, same encryption**.</string>
    <string name="MorsegramIntroTitle5">Powerful</string>
    <string name="MorsegramIntroText5">**Hidden chats**, local pins and an in-app\nairplane mode, all kept on this device.</string>
    <string name="MorsegramIntroTitle6">Cloud-Based</string>
    <string name="MorsegramIntroText6">Your chats stay in the **Telegram cloud**\nand open from every device.</string>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries><!-- <morsegram> trascrizione vocali on-device (S4): RecognitionService visibile (package visibility, target >= 30) per SpeechRecognizer.isOnDeviceRecognitionAvailable/isRecognitionAvailable/checkRecognitionSupport; il merger la unisce alle <queries> di TMessagesProj </morsegram> -->
    <application android:name="org.telegram.messenger.ApplicationLoaderImpl" tools:replace="name">
        <!-- <morsegram> Android Auto, solo percorso notifiche: Assistant legge i messaggi, risposta vocale, segna come letto.
             Upstream tiene la propria dichiarazione commentata dal 12.7.0; la nostra vive qui, nel modulo app, ed e' rebase-proof.
             ${morsegramAutoDesc} (TMessagesProj_App/build.gradle) = morsegram_auto_desc (solo notification, produzione) oppure
             morsegram_auto_desc_labs (notification+template) quando il modulo opt-in TMessagesProj_CarLabs e' nella build. -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/${morsegramAutoDesc}" tools:replace="android:resource" />
        <!-- guard: se un futuro upstream riattivasse il CarAppService "templated" (labs: respinto in produzione), lo togliamo dal manifest fuso.
             ${morsegramMinCarApiLevelGuard} = androidx.car.app.minCarApiLevel in produzione; con il modulo labs e' un nome fittizio,
             cosi' il remove (che il merger abbina per nome) non cancella il minCarApiLevel=7 dichiarato dal modulo. -->
        <service android:name="org.telegram.messenger.car.TelegramCarAppService" tools:node="remove" />
        <meta-data android:name="${morsegramMinCarApiLevelGuard}" tools:node="remove" />
        <!-- </morsegram> -->
        <!-- <morsegram> modalità aereo in-app: tile Quick Settings passiva (API 24+) + receiver dell'azione 'Disattiva' della notifica persistente; classi nel modulo libreria (it.iotatec.morsegram). Etichetta da morsegram_manifest.xml: le chiavi di strings.xml finiscono in tools:discard (TelegramStringsTask) -->
        <service android:name="it.iotatec.morsegram.AirplaneTileService" android:exported="true" android:icon="@drawable/morsegram_airplane" android:label="@string/morsegram_tile_label" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <receiver android:name="it.iotatec.morsegram.AirplaneReceiver" android:exported="false" />
        <!-- </morsegram> -->
        <!-- <morsegram> velocissimo (mission 1): profilabile da shell (Perfetto/simpleperf con callstack anche in release, ammesso da Play);
             via l'initializer EmojiCompat (Telegram disegna le emoji da sé: zero riferimenti a EmojiCompat in TMessagesProj) e il
             MlKitInitProvider (ContentProvider al process start): ML Kit viene inizializzato da it.iotatec.morsegram.perf.StartupReporter
             su globalQueue 1,5 s dopo il primo resume di qualsiasi activity; LanguageDetector upstream si auto-inizializza comunque.
             NON rimuovere FirebaseInitProvider (GcmPushListenerService può essere l'entry point del processo), ProcessLifecycleInitializer,
             ProfileInstallerInitializer (S5 baseline profile). Non e' coperto dalla build A/B -PMORSEGRAM_PERF=off (manifest, non Java). -->
        <profileable android:shell="true" tools:targetApi="29" />
        <provider android:name="androidx.startup.InitializationProvider" android:authorities="${applicationId}.androidx-startup" android:exported="false" tools:node="merge">
            <meta-data android:name="androidx.emoji2.text.EmojiCompatInitializer" tools:node="remove" />
        </provider>
        <provider android:name="com.google.mlkit.common.internal.MlKitInitProvider" android:authorities="${applicationId}.mlkitinitprovider" tools:node="remove" />
        <!-- </morsegram> -->
        <service
            android:name="org.telegram.messenger.GoogleVoiceClientService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
        />
        <activity
            android:name="org.telegram.messenger.GoogleVoiceClientActivity"
            android:exported="true"
        >
            <intent-filter>
                <action android:name="com.google.android.voicesearch.SEND_MESSAGE_TO_CONTACTS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
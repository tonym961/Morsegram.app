<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <application android:name="org.telegram.messenger.ApplicationLoaderImpl" tools:replace="name">
        <!-- <morsegram> Android Auto, solo percorso notifiche: Assistant legge i messaggi, risposta vocale, segna come letto.
             Upstream tiene la propria dichiarazione commentata dal 12.7.0; la nostra vive qui, nel modulo app, ed e' rebase-proof. -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/morsegram_auto_desc" tools:replace="android:resource" />
        <!-- guard: se un futuro upstream riattivasse il CarAppService "templated" (labs: respinto in produzione), lo togliamo dal manifest fuso -->
        <service android:name="org.telegram.messenger.car.TelegramCarAppService" tools:node="remove" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" tools:node="remove" />
        <!-- </morsegram> -->
        <service
            android:name="org.telegram.messenger.GoogleVoiceClientService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
        />
        <activity
            android:name="org.telegram.messenger.GoogleVoiceClientActivity"
            android:exported="true"
        >
            <intent-filter>
                <action android:name="com.google.android.voicesearch.SEND_MESSAGE_TO_CONTACTS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries><!-- <morsegram> trascrizione vocali on-device (S4): RecognitionService visibile (package visibility, target >= 30) per SpeechRecognizer.isOnDeviceRecognitionAvailable/isRecognitionAvailable/checkRecognitionSupport; il merger la unisce alle <queries> di TMessagesProj </morsegram> -->
    <application android:name="org.telegram.messenger.ApplicationLoaderImpl" tools:replace="name">
        <!-- <morsegram> Android Auto, solo percorso notifiche: Assistant legge i messaggi, risposta vocale, segna come letto.
             Upstream tiene la propria dichiarazione commentata dal 12.7.0; la nostra vive qui, nel modulo app, ed e' rebase-proof.
             ${morsegramAutoDesc} (TMessagesProj_App/build.gradle) = morsegram_auto_desc (solo notification, produzione) oppure
             morsegram_auto_desc_labs (notification+template) quando il modulo opt-in TMessagesProj_CarLabs e' nella build. -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/${morsegramAutoDesc}" tools:replace="android:resource" />
        <!-- guard: se un futuro upstream riattivasse il CarAppService "templated" (labs: respinto in produzione), lo togliamo dal manifest fuso.
             ${morsegramMinCarApiLevelGuard} = androidx.car.app.minCarApiLevel in produzione; con il modulo labs e' un nome fittizio,
             cosi' il remove (che il merger abbina per nome) non cancella il minCarApiLevel=7 dichiarato dal modulo. -->
        <service android:name="org.telegram.messenger.car.TelegramCarAppService" tools:node="remove" />
        <meta-data android:name="${morsegramMinCarApiLevelGuard}" tools:node="remove" />
        <!-- </morsegram> -->
        <!-- <morsegram> modalità aereo in-app: tile Quick Settings passiva (API 24+) + receiver dell'azione 'Disattiva' della notifica persistente; classi nel modulo libreria (it.iotatec.morsegram). Etichetta da morsegram_manifest.xml: le chiavi di strings.xml finiscono in tools:discard (TelegramStringsTask) -->
        <service android:name="it.iotatec.morsegram.AirplaneTileService" android:exported="true" android:icon="@drawable/morsegram_airplane" android:label="@string/morsegram_tile_label" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <receiver android:name="it.iotatec.morsegram.AirplaneReceiver" android:exported="false" />
        <!-- </morsegram> -->
        <!-- <morsegram> widget della schermata iniziale (modalita' aereo, chat nascoste, non letti, vocale rapido,
             chat singola). Classi e risorse (layout, drawable, res/xml/morsegram_widget_*_info.xml) vivono nel
             modulo LIBRERIA, perche' un AppWidgetProvider che sta nella libreria vede solo la R della libreria;
             le DICHIARAZIONI stanno qui, nel modulo app, come per la tile e il receiver della modalita' aereo:
             zero righe nel manifest di upstream, zero costo al rebase mensile.
             exported="false": il sistema consegna APPWIDGET_UPDATE al componente senza passare dalla visibilita'
             esterna (lo fanno anche i due provider di upstream, AndroidManifest.xml:631 e :646).
             android:label e android:description vengono da morsegram_widget_strings.xml (libreria) e non da
             strings.xml, le cui chiavi finiscono tutte in tools:discard. -->
        <receiver android:name="it.iotatec.morsegram.widget.AirplaneWidgetProvider" android:exported="false" android:label="@string/morsegram_widget_airplane_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/morsegram_widget_airplane_info" />
        </receiver>
        <receiver android:name="it.iotatec.morsegram.widget.HiddenWidgetProvider" android:exported="false" android:label="@string/morsegram_widget_hidden_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/morsegram_widget_hidden_info" />
        </receiver>
        <receiver android:name="it.iotatec.morsegram.widget.UnreadWidgetProvider" android:exported="false" android:label="@string/morsegram_widget_unread_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/morsegram_widget_unread_info" />
        </receiver>
        <receiver android:name="it.iotatec.morsegram.widget.VoiceWidgetProvider" android:exported="false" android:label="@string/morsegram_widget_voice_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/morsegram_widget_voice_info" />
        </receiver>
        <receiver android:name="it.iotatec.morsegram.widget.ChatWidgetProvider" android:exported="false" android:label="@string/morsegram_widget_chat_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/morsegram_widget_chat_info" />
        </receiver>
        <!-- configurazione: una sola schermata per tutti e cinque (il tipo si deduce dal provider dell'id).
             Stesso scheletro di org.telegram.ui.ChatsWidgetConfigActivity, quindi anche qui si passa dal passcode. -->
        <activity
            android:name="it.iotatec.morsegram.widget.MorsegramWidgetConfigActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- trampolino del widget chat nascoste: da Android 10 un BroadcastReceiver non puo' avviare activity,
             un PendingIntent di activity cliccato su un widget si'. Invisibile, fuori dai recenti, senza storia. -->
        <activity
            android:name="it.iotatec.morsegram.widget.WidgetOpenActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode" />
        <!-- registrazione del vocale rapido: non invia nulla, consegna il file a LaunchActivity con ACTION_SEND
             perche' la conferma di invio la dia l'utente nella chat. Task proprio, fuori dai recenti. -->
        <activity
            android:name="it.iotatec.morsegram.widget.VoiceRecordActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode" />
        <!-- </morsegram> -->
        <!-- <morsegram> velocissimo (mission 1): profilabile da shell (Perfetto/simpleperf con callstack anche in release, ammesso da Play);
             via l'initializer EmojiCompat (Telegram disegna le emoji da sé: zero riferimenti a EmojiCompat in TMessagesProj) e il
             MlKitInitProvider (ContentProvider al process start): ML Kit viene inizializzato da it.iotatec.morsegram.perf.StartupReporter
             su globalQueue 1,5 s dopo il primo resume di qualsiasi activity; LanguageDetector upstream si auto-inizializza comunque.
             NON rimuovere FirebaseInitProvider (GcmPushListenerService può essere l'entry point del processo), ProcessLifecycleInitializer,
             ProfileInstallerInitializer (S5 baseline profile). Non e' coperto dalla build A/B -PMORSEGRAM_PERF=off (manifest, non Java). -->
        <profileable android:shell="true" tools:targetApi="29" />
        <provider android:name="androidx.startup.InitializationProvider" android:authorities="${applicationId}.androidx-startup" android:exported="false" tools:node="merge">
            <meta-data android:name="androidx.emoji2.text.EmojiCompatInitializer" tools:node="remove" />
        </provider>
        <provider android:name="com.google.mlkit.common.internal.MlKitInitProvider" android:authorities="${applicationId}.mlkitinitprovider" tools:node="remove" />
        <!-- </morsegram> -->
        <service
            android:name="org.telegram.messenger.GoogleVoiceClientService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
        />
        <activity
            android:name="org.telegram.messenger.GoogleVoiceClientActivity"
            android:exported="true"
        >
            <intent-filter>
                <action android:name="com.google.android.voicesearch.SEND_MESSAGE_TO_CONTACTS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>